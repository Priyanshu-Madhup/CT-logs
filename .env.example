# Copy to .env (local) or set these in Vercel > Project > Settings > Environment Variables.
# NOTE: VITE_ variables are embedded in the built site and visible to visitors.

# ctlogs.dev API key (https://account.ctlogs.dev/). Optional: raises quota and enables deep paging.
CTLOGS_KEY=your_ctlogs_api_key_here

# logo.dev PUBLISHABLE key (pk_...). Never put the secret key (sk_...) here.
LOGODEV_KEY=pk_your_logodev_publishable_key_here
